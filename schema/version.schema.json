{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "App version manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["versionCode", "versionName", "updateUrl", "updateNotes", "isForceUpdate"],
  "properties": {
    "versionCode": {
      "type": "integer",
      "minimum": 1
    },
    "versionName": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-(tv|mobile)$"
    },
    "updateUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/IO-Player/app-updates/releases/download/.+\\.apk$"
    },
    "updateNotes": {
      "type": "string",
      "minLength": 1
    },
    "isForceUpdate": {
      "type": "boolean"
    }
  }
}
